{
  "name": "corvex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-ops-ui.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:review": "tsx scripts/review-benchmark.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "cheerio": "^1.2.0",
    "typebox": "^1.3.27",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "undici": "8.12.3"
  }
}
