{
  "name": "corvex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "pnpm run ui:build && tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json && vite build --config src/app/ui/vite.config.ts",
    "ui:build": "vite build --config src/app/ui/vite.config.ts",
    "ui:dev": "vite --config src/app/ui/vite.config.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p src/app/ui/tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "pnpm run ui:build && vitest run",
    "test:watch": "pnpm run ui:build && vitest",
    "benchmark:review": "tsx scripts/review-benchmark.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@ant-design/x": "^2.10.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "antd": "^6.7.0",
    "eslint": "^10.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "cheerio": "^1.2.0",
    "typebox": "^1.3.27",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "undici": "8.12.3"
  }
}
