# Optional startup fallbacks. Prefer setting these in the console Settings page;
# blank values are ignored on save, so saved secrets are never overwritten by accident.
# CORVEX_GITLAB_READ_TOKEN=replace-with-read-only-token
# CORVEX_GITLAB_TOKEN=replace-with-token-that-can-post-mr-notes
# CORVEX_WEBHOOK_SECRET=replace-with-a-long-random-secret
CORVEX_IMAGE_TAG=latest
